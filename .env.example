SUPABASE_SERVICE_ROLE_KEY=server-only-secret
LEADERBOARD_PASSCODE=MantappuJiwa
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_PASSCODE=replace-with-a-strong-admin-passcode

